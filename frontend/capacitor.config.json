{
  "appId": "co.edu.unicesar.upctrack",
  "appName": "UpcTrack",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 3000,
      "backgroundColor": "#fbfaf4",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#fbfaf4"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_upctrack",
      "iconColor": "#1E6B2E"
    }
  }
}
