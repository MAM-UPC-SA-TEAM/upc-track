# Backend server
PORT=3000

# PostgreSQL. Se configura de UNA de estas dos formas (DATABASE_URL tiene prioridad).
#
# 1) Neon (produccion y pruebas contra la nube): copia la cadena de conexion de la
#    consola de Neon (Connect > Connection string) con sslmode=require. Es un secreto:
#    va solo en backend/.env o en las variables de Render, nunca en el repositorio.
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# 2) Desarrollo local: el contenedor de docker-compose (puerto 5433).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bd_monitoreo_buses
# DB_SSL=true   # fuerza TLS con las variables DB_* (con DATABASE_URL basta sslmode=require)

# JWT
JWT_SECRET=change-this-super-secret-value
JWT_EXPIRES_IN=7d

# Allowed client origins (comma-separated). Use * only for temporary tests.
# Produccion: solo el dominio del frontend en Cloudflare, por ejemplo
#   CLIENT_URL=https://upc-track.manuel0726tocora.workers.dev
# NO hace falta listar la app Android/iOS (Capacitor): sus origenes
# (https://localhost y capacitor://localhost) ya estan permitidos en
# src/utils/cors.js en todos los entornos.
# En desarrollo tambien se aceptan localhost, la red LAN y ngrok automaticamente.
CLIENT_URL=http://localhost:5173
