{
  "name": "bus-monitor-upc-backend",
  "version": "1.0.0",
  "description": "Backend del aplicativo de monitoreo de buses UPC Seccional Aguachica",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:usuario": "node scripts/db/crear-usuario.mjs",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html --include=\"src/**\" node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.23.1",
    "socket.io": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.3.2"
  }
}
